{
  "name": "dueline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Everything you need to pay, on one line. Built by Gaurav Kumar, The Algothrim.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project dueline-app \"vitest run --config vitest.rules.config.ts\"",
    "icons": "python scripts/make-icons.py",
    "deploy:web": "npm run build && firebase deploy --only hosting --project dueline-app",
    "deploy:rules": "firebase deploy --only firestore --project dueline-app",
    "deploy:api": "npm run build:api && vercel deploy --prod",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^16.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
