{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo bundled",
  "buildCommand": "echo bundled",
  "outputDirectory": "api-static",
  "functions": {
    "api/tick.js": {
      "maxDuration": 60
    },
    "api/test-push.js": {
      "maxDuration": 15
    }
  },
  "crons": [
